Package: polecon
Title: Quantitative Methods for Political Economy
Version: 0.1.0
Authors@R: c(
    person("Stefanos", "Stavrianos", email = "stefanstavrianos@aua.gr",
           role = c("aut", "cre", "cph")),
    person("Owen", "O'Donnell", role = c("ctb", "cph")),
    person("Stephen", "O'Neill", role = c("ctb", "cph")),
    person("Tom", "Van Ourti", role = c("ctb", "cph")),
    person("Brendan", "Walsh", role = c("ctb", "cph"))
